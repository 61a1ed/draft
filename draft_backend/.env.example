DATABASE_URL=postgresql://dl_gateway:CHANGE_ME@127.0.0.1:5432/draft
# A separate startup connection allowed to SET ROLE dl_owner.
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/draft
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PUBLIC_BASE_URL=http://127.0.0.1:8000
APP_ENV=development
COOKIE_SECURE=false
TEST_LOGIN_ENABLED=false
OIDC_ISSUER=https://accounts.google.com
OIDC_CALLBACK_PATH=/auth/callback
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Per worker: reserve DB_POOL_SIZE query connections plus up to SSE_MAX_CONNECTIONS
# dedicated browser-tab listeners. Budget PostgreSQL capacity and rollout headroom.
DB_POOL_SIZE=10
SSE_MAX_CONNECTIONS=30
